# Redis 连接
REDIS_URL=redis://redis:6379/0

# 邮箱域名（逗号分隔）
MAIL_DOMAINS=tempmail.dev

# 邮箱过期时间（分钟）
MAIL_EXPIRE_MINUTES=60

# SMTP 服务
SMTP_HOST=0.0.0.0
SMTP_PORT=25

# API 服务
API_HOST=0.0.0.0
API_PORT=8000

# CORS 允许的源（逗号分隔）
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# 清理任务间隔（秒）
CLEANER_INTERVAL=60
